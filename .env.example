# ---------------------------------------------------------------------------
# Cookie Notes environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Any PostgreSQL 14+ instance. Local example:
#   postgresql://postgres:postgres@localhost:5432/scholarvault
# Neon / Supabase / Railway give you a ready-made URL — paste it here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scholarvault"

# --- Application -----------------------------------------------------------
# Public origin of the app. Used for password-reset links and cookie security.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Secrets ---------------------------------------------------------------
# Generate each with:  openssl rand -base64 32
# AUTH_SECRET signs session-related values; VIEW_TOKEN_SECRET signs the
# short-lived tokens that authorise a single note-content request.
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
VIEW_TOKEN_SECRET="replace-me-with-a-different-openssl-rand-base64-32"

# --- Sessions --------------------------------------------------------------
# Absolute session lifetime (hours) and inactivity timeout (minutes) for an
# ordinary sign-in.
SESSION_ABSOLUTE_HOURS="168"
SESSION_IDLE_MINUTES="30"
# Lifetime of a "Keep me signed in" session, in days. Used as both its absolute
# lifetime and its idle window — such a session simply lives this long unless it
# is ended by logout, a password reset, or an admin.
SESSION_REMEMBER_DAYS="30"
# Minutes of recent activity that counts as "studying right now".
#
# This is what defines an Active User, and it is deliberately separate from the
# two settings above: staying signed in is an authentication fact, being active
# is an activity fact. Widening this would redefine every "active now" number in
# the product, so change it only if that is what you mean to do.
LIVE_WINDOW_MINUTES="5"

# --- Consent ---------------------------------------------------------------
# Which revision of the terms and of the analytics notice new students agree to.
# Recorded against each account at sign-up, so a later revision can be told
# apart from the text someone actually saw. Bump these whenever the wording in
# src/app/(public)/terms/page.tsx or the sign-up checkbox changes materially.
TERMS_VERSION="2026-09-01"
ANALYTICS_CONSENT_VERSION="2026-09-01"

# --- Storage ---------------------------------------------------------------
# "local" keeps PDFs in a private directory on the server (good for local dev
# and single-server deploys). "s3" works with AWS S3, Cloudflare R2, Backblaze
# B2, MinIO and Supabase Storage's S3 endpoint (required for serverless hosts
# such as Vercel, whose filesystem is read-only and ephemeral).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.private-storage"

# Only needed when STORAGE_DRIVER="s3"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""              # e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"  # true for R2/MinIO/Supabase, false for AWS S3

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB="50"

# --- Rate limiting ---------------------------------------------------------
LOGIN_MAX_ATTEMPTS="8"
LOGIN_WINDOW_MINUTES="15"
LOCKOUT_MINUTES="15"
# Sign-up attempts one IP address may make per hour. Registration is always rate
# limited; there is no value that turns it off. A campus often shares one public
# IP, so while EMAIL_VERIFICATION_REQUIRED is off the default is 100; with
# verification on (every attempt sends an email) it is 10. A whole number of at
# least 1 — anything else is ignored and the default applies.
REGISTER_MAX_PER_HOUR="100"

# --- First admin (used by `npm run create:admin`) ---------------------------
# Optional: if set, the script runs non-interactively. Remove them afterwards.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Platform Admin"

# --- Email (password reset) ------------------------------------------------
# "console" prints reset links to the server log (fine for the free MVP).
# "resend" sends real email through https://resend.com.
MAIL_DRIVER="console"
MAIL_FROM="Cookie Notes <no-reply@example.com>"
RESEND_API_KEY=""

# --- Email verification ----------------------------------------------------
# Whether sign-up needs a college (@mitwpu.edu.in) address and an emailed code,
# and whether an unverified student is stopped from reading notes.
#
#   "false" (or unset / empty) — OFF, the intended setting for the free launch.
#       Any valid email can register and is signed in at once. No code is sent.
#       Existing accounts that never verified can sign in with their password,
#       and are NOT marked verified. The verification pages redirect away and
#       the verification APIs answer 404.
#   "true" — ON. The college-email policy, the sign-up code and the reading gate
#       apply exactly as they did before.
#   anything else (e.g. "yes", a typo) — treated as ON, and a warning is logged at
#       startup, so a typo can never quietly switch a check off.
#
# Case and spaces are ignored; "1" and "0" also work. Nothing in the database is
# deleted or changed by switching it. A change needs a redeploy to take effect.
EMAIL_VERIFICATION_REQUIRED="false"

# Whether the reader burns the reader's email onto each page ("Licensed to…").
# OFF ("false", unset or anything but "true"/"1") for the free launch; set "true"
# to bring it back, for paid notes. When off, no email is sent to the viewer.
NOTE_WATERMARK_ENABLED="false"

# --- Admin analytics --------------------------------------------------------
# The clock the admin "when students study" chart uses, so hours of the day are
# local hours. An IANA time zone name; unset or unrecognised falls back to
# Asia/Kolkata.
ANALYTICS_TIMEZONE="Asia/Kolkata"

# --- Catalogue & pricing ---------------------------------------------------
# Open preview. While true, any SIGNED-IN active student can open any published
# note, whether or not an entitlement covers it. Authentication, session
# validity, note status and the short-lived view token are all still enforced,
# and admin grants keep working exactly as before — set this to false and the
# platform becomes entitlement-gated with no other change.
OPEN_ACCESS_MODE="true"

# Symbol shown next to note prices. Display only; no payment is taken yet.
PRICE_CURRENCY_SYMBOL="₹"

# ---------------------------------------------------------------------------
# Prisma engine download (only if your network blocks binaries.prisma.sh)
# ---------------------------------------------------------------------------
# The generator this project uses is pure JavaScript and never invokes the
# schema engine, so a placeholder file satisfies the CLI's check:
#   touch /tmp/no-engine && chmod +x /tmp/no-engine
# PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING="1"
# PRISMA_SCHEMA_ENGINE_BINARY="/tmp/no-engine"
